#!/usr/bin/env bash
# Fast gate: secrets, formatting, lint, types and file cycles. No tests.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
# Git hooks inherit repo-scoped env vars that can break nested git commands.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is required; install it before committing" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --verbose
make lint-check
make cycles
make vocabulary
