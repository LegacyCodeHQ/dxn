      "gap": 48,
      "padding": 80,
      "children": [
        {
          "type": "text",
          "id": "bV8jk",
          "name": "Title",
          "fill": "$slate",
          "content": "BLUEPRINT MODE / A BACKGROUND FOR SOCIAL, HERO AND DOCUMENTATION ART",
          "fontFamily": "$font-text",
          "fontSize": 12,
          "fontWeight": "600",
          "letterSpacing": 1.5
        },
        {
          "type": "frame",
          "id": "Eiuc2",
          "name": "Examples",
          "gap": 40,
          "children": [
            {
              "type": "rectangle",
              "id": "r8a15e",
              "name": "Example X 1600x900",
              "fill": {
                "type": "image",
                "enabled": true,
