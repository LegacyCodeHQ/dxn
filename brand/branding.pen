      "width": 1600,
      "fill": "$canvas",
      "layout": "vertical",
      "gap": 48,
      "padding": 80,
      "children": [
        {
          "type": "text",
          "id": "bV8jk",
          "name": "Title",
          "fill": "$slate",
          "content": "BLUEPRINT MODE / A BACKGROUND FOR SOCIAL, HERO AND DOCUMENTATION ART",
          "fontFamily": "$font-text",
          "fontSize": 12,
          "fontWeight": "600",
          "letterSpacing": 1.5
        },
        {
          "type": "frame",
          "id": "Eiuc2",
          "name": "Examples",
          "gap": 40,
          "children": [
            {
              "type": "rectangle",
              "id": "r8a15e",
              "name": "Example X 1600x900",
              "fill": {
                "type": "image",
                "enabled": true,
                "url": "launch/coming-soon-x-1600x900-2x.png",
                "mode": "cover"
              },
              "width": 800,
              "height": 450
            },
            {
              "type": "rectangle",
              "id": "F1poj",
              "name": "Example LinkedIn 1200x627",
              "fill": {
                "type": "image",
                "enabled": true,
                "url": "launch/coming-soon-linkedin-1200x627-2x.png",
                "mode": "cover"
              },
              "width": 600,
              "height": 313.5
            }
          ]
        },
        {
          "type": "text",
          "id": "YoJJE",
          "name": "Rules Label",
          "fill": "$slate",
          "content": "BLUEPRINT MODE / RULES",
          "fontFamily": "$font-text",
          "fontSize": 12,
          "fontWeight": "600",
          "letterSpacing": 1.5
        },
        {
          "type": "frame",
          "id": "l4txo",
          "name": "Rules",
          "width": "fill_container",
          "gap": 40,
          "children": [
            {
              "type": "frame",
              "id": "F0JSj5",
              "name": "Modes",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "u1FdC",
                  "name": "Heading",
                  "fill": "$slate",
                  "content": "MODES",
                  "fontFamily": "$font-text",
                  "fontSize": 12,
                  "fontWeight": "600",
                  "letterSpacing": 1.5
                },
                {
                  "type": "text",
                  "id": "cRKBZ",
                  "name": "Rule",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A third mode, for backgrounds: a measured layout drawn as an isometric blueprint. One mode per surface: never with the mat pattern or a marking.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "GlPWe",
                  "name": "Rule",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "For social images, hero art and documentation headers. Not for the logo, the product interface or file icons.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "JbBP2",
              "name": "Color",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "NW6P7",
                  "name": "Heading",
                  "fill": "$slate",
                  "content": "SUBJECT",
                  "fontFamily": "$font-text",
                  "fontSize": 12,
                  "fontWeight": "600",
                  "letterSpacing": 1.5
                },
                {
                  "type": "text",
                  "id": "sdywQ",
                  "name": "Rule",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Draw a layout of our own or of a made-up site such as Tidepool: the dxn editor, site or documentation, or an invented product, ideally at several breakpoints. Never another company's page.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "u1HMIh",
                  "name": "Rule",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Lift one element out of the page and measure it. One lifted element per image.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "jIWSt",
                  "name": "Rule",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Measurements say one thing: the lifted element's width and height. The page size lines are optional.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "jegFI",
              "name": "Line and placement",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "asXCG",
                  "name": "Heading",
                  "fill": "$slate",
                  "content": "COLOR",
                  "fontFamily": "$font-text",
                  "fontSize": 12,
                  "fontWeight": "600",
                  "letterSpacing": 1.5
                },
                {
                  "type": "text",
                  "id": "iSmKq",
                  "name": "Rule",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Surface is Paper or Ink. Lines, slab and grid are the surface with a share of the other color mixed in: solid, no transparency. The tool derives them from brand.json.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "CyUJM",
                  "name": "Rule",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The lifted element is Accent #4F5BFF with Paper lines, and the only use of accent in the image.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "FcOOS",
                  "name": "Rule",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Labels are Slate on paper and Slate on Ink on ink.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "HbbW0",
              "name": "Text and use",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "O3rWRY",
                  "name": "Heading",
                  "fill": "$slate",
                  "content": "LINE AND VIEW",
                  "fontFamily": "$font-text",
                  "fontSize": 12,
                  "fontWeight": "600",
                  "letterSpacing": 1.5
                },
                {
                  "type": "text",
                  "id": "J4HCmY",
                  "name": "Rule",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Stroke 1.25px by default, 1 to 2px at any size; never thicken when scaling.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "ilaiY",
                  "name": "Rule",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Flat isometric view by default; stacked layers only to show breakpoints. Rotate in 90 degree steps only.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "eS9py",
                  "name": "Rule",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The viewport is a slab and always the visible part: clip what runs past it.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "X2QhZY",
              "name": "Text and use",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "mbe4x",
                  "name": "Heading",
                  "fill": "$slate",
                  "content": "TEXT AND USE",
                  "fontFamily": "$font-text",
                  "fontSize": 12,
                  "fontWeight": "600",
                  "letterSpacing": 1.5
                },
                {
                  "type": "text",
                  "id": "YXPx0",
                  "name": "Rule",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Lockup in the bottom-left corner, clear of the lifted element and its labels.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "kuDix",
                  "name": "Rule",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A caption under the lockup is Bold and as wide as the lockup, end to end.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "SOZBS",
                  "name": "Rule",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Check every image at 400px wide: the lockup and the lifted element must still read. Make it with brand/blueprint.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },
