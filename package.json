{
  "name": "@legacycodehq/task-tree",
  "version": "0.0.0",
  "description": "Track what has been specified, built and verified for a tree of tasks across dimensions.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "task-tree": "dist/main.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "biome check . && tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
