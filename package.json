{
  "name": "@legacycodehq/dxn-workspace",
  "version": "0.0.0",
  "description": "The dxn command and the dxn language, as npm workspaces.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/language",
    "packages/cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "make build",
    "check": "biome check . && tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
