{
  "name": "@legacycodehq/dxn-workspace",
  "version": "0.0.0",
  "description": "The dxn command and the dxn language, as npm workspaces.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/language",
    "packages/cli",
    "packages/language-server",
    "packages/vscode",
    "packages/tree-sitter-dxn",
    "packages/next"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "make build",
    "check": "make check",
    "coverage": "make coverage",
    "coverage:javascript": "vitest run --coverage",
    "coverage:zed": "make coverage-zed",
    "test": "make test"
  },
  "devDependencies": {
    "@babel/parser": "7.29.12",
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "get-tsconfig": "4.14.3",
    "tsc-alias": "1.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "tree-sitter-cli@0.27.1": true,
    "tree-sitter@0.25.1": true,
    "@legacycodehq/tree-sitter-dxn@0.1.0": true
  },
  "overrides": {
    "vscode-languageclient": {
      "minimatch": "11.0.1"
    }
  }
}
