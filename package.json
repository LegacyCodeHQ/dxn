{
  "name": "@legacycodehq/dxn-workspace",
  "version": "0.0.0",
  "description": "The dxn command and the dxn language, as npm workspaces.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/language",
    "packages/cli",
    "packages/language-server",
    "packages/vscode",
    "packages/tree-sitter-dxn"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "make build",
    "check": "make check",
    "test": "make test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "tree-sitter-cli@0.27.1": true
  },
  "overrides": {
    "vscode-languageclient": {
      "minimatch": "11.0.1"
    }
  }
}
