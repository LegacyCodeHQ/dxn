# Every construct of dxn, for checking the extension's queries.
dimension Breakpoint =
  | base
  | lg
dimension Pointer = mouse | touch

enum Hover = rest | hovered
enum Section = home | blog
enum Openness = closed | open
enum Selection = unselected | selected
enum Layout = compact | inline
enum Focus = blurred | focused

type Link needs Pointer receives current: Section {
  event activate
  state hover: Hover
  state selection: Selection
  state focus: Focus
  hover = hovered only when Pointer = mouse
    and focus = blurred
  alike Pointer
  alike hover in (rest, hovered) when selection = selected
  action take-focus: focus blurred -> focused
  on activate: focus -> focused
}

type Menu needs Breakpoint {
  event escape
  state menu: Openness
  state layout: Layout = when Breakpoint {
    base -> compact
    lg -> inline
  }
  has link: Link {
    selection = when menu { open -> selected, closed -> unselected }
  } only when menu = open and (layout = compact or Breakpoint = base)
  action close: menu open -> closed
  on escape: close, link.take-focus only when menu = open
  on Breakpoint in (lg): close
}

type Page {
  state current: Section = blog
  provides current
  has menu: Menu
}

environment Device = Breakpoint x Pointer
profile phone: Device { Breakpoint = base, Pointer = touch }
profile laptop: Device { Breakpoint = lg, Pointer = mouse }
modifier trackpad on phone { Pointer = mouse }

actor designer records Evidence
record Evidence {
  at: Timestamp
  source: PenNode
}

enum Verdict = approved | changes
enum Next = ship | redraw
actor reviewer records Review
record Review {
  verdict: Verdict
  next: Next = when verdict {
    approved -> ship
    changes -> redraw
  }
}

expect "Escape closes the open menu" {
  in Page.menu and below
  when menu = open, profile = phone+trackpad
  on escape
  then menu = closed, link.focus = focused
}
