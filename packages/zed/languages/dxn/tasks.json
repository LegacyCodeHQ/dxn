[
  {
    "label": "dxn states $ZED_CUSTOM_type",
    "command": "dxn",
    "args": ["states", "$ZED_RELATIVE_FILE", "$ZED_CUSTOM_type"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["dxn-type"]
  },
  {
    "label": "dxn states $ZED_CUSTOM_parent.$ZED_CUSTOM_type",
    "command": "dxn",
    "args": ["states", "$ZED_RELATIVE_FILE", "$ZED_CUSTOM_parent.$ZED_CUSTOM_type"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["dxn-nested-type"]
  },
  {
    "label": "dxn review $ZED_RELATIVE_FILE",
    "command": "dxn review \"$ZED_RELATIVE_FILE\" | sed -n \"s/^Wrote //p\" | while IFS= read -r page; do zed \"$page\"; done",
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["dxn-type", "dxn-nested-type"]
  },
  {
    "label": "dxn check --expect $ZED_CUSTOM_title",
    "command": "dxn",
    "args": ["check", "$ZED_RELATIVE_FILE", "--expect", "$ZED_CUSTOM_title"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["dxn-expect"]
  }
]
