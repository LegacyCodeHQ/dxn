{
  "name": "dxn",
  "displayName": "dxn",
  "description": "Language support for dxn: highlighting, inline errors, navigation, completion, rename, and running types and expectations.",
  "version": "0.1.0",
  "publisher": "legacycodehq",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/LegacyCodeHQ/dxn"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:dxn"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dxn",
        "aliases": [
          "dxn"
        ],
        "extensions": [
          ".dxn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dxn",
        "scopeName": "source.dxn",
        "path": "./syntaxes/dxn.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "dxn",
      "properties": {
        "dxn.server.path": {
          "type": "string",
          "default": "",
          "description": "The language server to run instead of the one the extension bundles, such as node, or a dxn-language-server on the PATH."
        },
        "dxn.server.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments to the language server dxn.server.path names, such as the path to a development build's dist/main.js."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "dxn",
        "required": [
          "args"
        ],
        "properties": {
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What dxn runs, after its command the file: states and a type, or check, --expect and an expectation's title."
          }
        }
      }
    ],
    "configurationDefaults": {
      "[dxn]": {
        "editor.defaultFormatter": "legacycodehq.dxn",
        "editor.formatOnSave": true
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "1.100.0",
    "esbuild": "0.28.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  }
}
