{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dxn overrides",
  "description": "Editor aid for overrides/<dimension>.json; the file name is the dimension it overrides for. The dimensions compiler is the authority: it also checks that values, types, nodes, states and attribute values exist and are in scope, which this schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "overrides"],
  "properties": {
    "$schema": {
      "description": "Path or URL of this schema, for editors.",
      "type": "string"
    },
    "version": {
      "description": "Format version.",
      "const": 1
    },
    "only": {
      "description": "Node id -> the values where the node and its subtree exist; nodes not listed exist everywhere.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "overrides": {
      "description": "Overrides by dimension value.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/valueOverrides"
      }
    }
  },
  "$defs": {
    "name": {
      "description": "Non-blank, without leading or trailing whitespace or control characters.",
      "type": "string",
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
    },
    "valueOverrides": {
      "description": "What changes for types and nodes when the dimension has this value.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "types": {
          "description": "Overrides by type name.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/override"
          }
        },
        "nodes": {
          "description": "Overrides by node id; applied after the node's type override.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/override"
          }
        }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "states": {
          "description": "States removed from or added to the type in this context.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "remove": {
              "$ref": "#/$defs/stateList"
            },
            "add": {
              "$ref": "#/$defs/stateList"
            }
          }
        },
        "attributes": {
          "description": "Attribute values in this context, by attribute name, then by state.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "stateList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    }
  }
}
