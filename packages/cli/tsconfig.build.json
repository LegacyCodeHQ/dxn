{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "paths": { "@cli/*": ["./src/*"] },
    // Inside dist, so removing dist also forces a full rebuild.
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../next/tsconfig.build.json" }]
}
