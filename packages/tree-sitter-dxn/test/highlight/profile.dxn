dimension Pointer = mouse | touch
environment Device = Pointer
profile Phone: Device { Pointer = touch }
#       ^ type
modifier Trackpad on Phone { Pointer = mouse }
#        ^ type
#                    ^ type
type Menu {
}
expect "A phone" {
  in Menu
  when profile = Phone
#                ^ type
  some profile = Phone+Trackpad
#                ^ type
#                      ^ type
}
