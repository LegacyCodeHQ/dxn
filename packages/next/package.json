{
  "name": "@legacycodehq/dxn-next",
  "version": "0.0.0",
  "description": "The new dxn implementation, built to the Lean specification in lean/.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.build.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json && tsc-alias -p tsconfig.build.json --no-resolve-package-subpaths"
  }
}
