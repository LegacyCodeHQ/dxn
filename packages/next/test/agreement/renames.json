  {
    "title": "rename an enumeration",
    "declarations": [
      { "name": "Light", "values": ["off", "on"] },
      { "name": "Power", "values": ["off", "on"] }
    ],
    "rename": { "from": "Light", "to": "Lamp" }
  },
  {
    "title": "rename an enumeration to its own name",
