    "rename": { "from": "Light", "to": "Light" }
  },
  {
    "title": "rename in a file with problems",
    "declarations": [{ "name": "Light", "values": [] }],
    "rename": { "from": "Light", "to": "Lamp" }
  },
  {
    "title": "rename to a name that breaks the naming rules",
