{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-tree task",
  "description": "Editor aid for tasks/<id>.json. The task-tree compiler is the authority: it also checks that the root task's id matches the file name, that ids are unique across the project, that included components exist without cycles or repeats, and that types, attributes, states and values exist, which this schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "task"],
  "properties": {
    "$schema": {
      "description": "Path or URL of this schema, for editors.",
      "type": "string"
    },
    "version": {
      "description": "Format version.",
      "const": 1
    },
    "task": {
      "description": "The root task of this file; its id must match the file name.",
      "$ref": "#/$defs/task"
    }
  },
  "$defs": {
    "name": {
      "description": "Non-blank, without leading or trailing whitespace or control characters.",
      "type": "string",
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
    },
    "text": {
      "description": "Non-blank, without control characters.",
      "type": "string",
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])[\\s\\S]*\\S[\\s\\S]*$"
    },
    "attributeValues": {
      "description": "Custom attribute values, by attribute name, then by state.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "dependentRequired": {
        "customAttributes": ["type"]
      },
      "properties": {
        "id": {
          "description": "Unique across the whole tree.",
          "$ref": "#/$defs/name"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "description": "Name of a type in the top-level types.",
          "type": "string"
        },
        "onlyWhen": {
          "description": "Shared ancestor id -> the states in which this task and its subtree exist.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/name"
            }
          }
        },
        "children": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/task"
              },
              {
                "$ref": "#/$defs/include"
              }
            ]
          }
        },
        "customAttributes": {
          "description": "Overrides the type's values, state by state.",
          "$ref": "#/$defs/attributeValues"
        }
      }
    },
    "include": {
      "description": "Brings a component's subtree in at this position.",
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "description": "Id of a component in components/.",
          "$ref": "#/$defs/name"
        },
        "states": {
          "description": "Task in the component -> state group -> the only values that task has through this include.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/name"
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/name"
              }
            }
          }
        }
      }
    }
  }
}
