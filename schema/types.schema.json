{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-tree types",
  "description": "Editor aid for types.json. The task-tree compiler is the authority: it also checks that custom attribute values use declared attributes, the type's states and declared values, and that required checks are declared, which this schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": {
      "description": "Path or URL of this schema, for editors.",
      "type": "string"
    },
    "version": {
      "description": "Format version.",
      "const": 1
    },
    "customAttributes": {
      "description": "Declares the custom attributes that types and tasks may use, and their allowed values.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/declaration"
      },
      "propertyNames": {
        "$ref": "#/$defs/name"
      }
    },
    "customChecks": {
      "description": "Declares the checks types may require, such as visual or behavior.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "types": {
      "description": "Reusable task types, by name.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/type"
      },
      "propertyNames": {
        "$ref": "#/$defs/name"
      }
    }
  },
  "$defs": {
    "name": {
      "description": "Non-blank, without leading or trailing whitespace or control characters.",
      "type": "string",
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values"],
      "properties": {
        "values": {
          "description": "Allowed values of this attribute.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        }
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "states": {
          "description": "States every instance of this type has.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "checks": {
          "description": "Declared checks every instance of this type must pass, in every context.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "customAttributes": {
          "$ref": "#/$defs/attributeValues"
        }
      }
    },
    "attributeValues": {
      "description": "Custom attribute values, by attribute name, then by state.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  }
}
