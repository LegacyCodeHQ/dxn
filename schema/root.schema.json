{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-tree root",
  "description": "Editor aid for roots/<id>.json. The task-tree compiler is the authority: it also checks that the root's id matches the file name, that ids are unique across the project, that included components exist without cycles or repeats, and that types, attributes, states and values exist, which this schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "root"],
  "properties": {
    "$schema": {
      "description": "Path or URL of this schema, for editors.",
      "type": "string"
    },
    "version": {
      "description": "Format version.",
      "const": 1
    },
    "root": {
      "description": "The root of this file: a node with no parent. Its id must match the file name.",
      "$ref": "#/$defs/node"
    }
  },
  "$defs": {
    "name": {
      "description": "Non-blank, without leading or trailing whitespace or control characters.",
      "type": "string",
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])\\S(?:[\\s\\S]*\\S)?$"
    },
    "text": {
      "description": "Non-blank, without control characters.",
      "type": "string",
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])[\\s\\S]*\\S[\\s\\S]*$"
    },
    "attributeValues": {
      "description": "Custom attribute values, by attribute name, then by state.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "dependentRequired": {
        "customAttributes": ["type"]
      },
      "properties": {
        "id": {
          "description": "Unique across the whole tree.",
          "$ref": "#/$defs/name"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "description": "Name of a type in the top-level types.",
          "type": "string"
        },
        "onlyWhen": {
          "description": "Shared ancestor id -> the states in which this node and its subtree exist.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/name"
            }
          }
        },
        "transitions": {
          "description": "How this shared node's state changes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/node"
              },
              {
                "$ref": "#/$defs/include"
              }
            ]
          }
        },
        "customAttributes": {
          "description": "Overrides the type's values, state by state.",
          "$ref": "#/$defs/attributeValues"
        }
      }
    },
    "include": {
      "description": "Brings a component's subtree in at this position.",
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "description": "Id of a component in components/.",
          "$ref": "#/$defs/name"
        },
        "states": {
          "description": "Node in the component -> state group -> the only values that node has through this include.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/$defs/name"
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/name"
              }
            }
          }
        }
      }
    },
    "transition": {
      "description": "A change of a shared node's state on a DOM event.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "on"],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "from": {
          "$ref": "#/$defs/name"
        },
        "to": {
          "$ref": "#/$defs/name"
        },
        "on": {
          "enum": ["click", "keydown", "pointerdown", "resize"]
        },
        "key": {
          "description": "keydown: the key, as KeyboardEvent.key names it.",
          "$ref": "#/$defs/name"
        },
        "target": {
          "description": "click and pointerdown: the node the event happens on.",
          "$ref": "#/$defs/name"
        },
        "outside": {
          "description": "pointerdown: the node the event happens outside of.",
          "$ref": "#/$defs/name"
        },
        "when": {
          "description": "resize: dimension -> the values it changes to.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/name"
            }
          }
        },
        "focus": {
          "description": "Where keyboard focus ends up.",
          "$ref": "#/$defs/name"
        }
      }
    }
  }
}
