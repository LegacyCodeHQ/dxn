{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-tree dimensions",
  "description": "Editor aid for dimensions.json. The task-tree compiler is the authority: it also checks that appliesTo names tasks in tree.json, which this schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "dimensions"],
  "properties": {
    "$schema": {
      "description": "Path or URL of this schema, for editors.",
      "type": "string"
    },
    "version": {
      "description": "Format version.",
      "const": 1
    },
    "dimensions": {
      "description": "Dimensions by name, such as breakpoint or pointer.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/dimension"
      },
      "propertyNames": {
        "$ref": "#/$defs/name"
      }
    }
  },
  "$defs": {
    "name": {
      "description": "Non-blank, without leading or trailing whitespace.",
      "type": "string",
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "appliesTo"],
      "properties": {
        "values": {
          "description": "Values this dimension takes.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "appliesTo": {
          "description": "Ids of the tasks this dimension applies to; each task's subtree is included.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        }
      }
    }
  }
}
