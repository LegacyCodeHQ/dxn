dimension TreeSitterChange = grammar | scanner | both | none
enum TreeSitterParser = regenerate | keep
enum ZedExtensionPin = update | keep
enum RequiredChange = modify | keep
enum VerificationResult = unverified | passed | failed

## Responsibilities for implementing the redesigned language from its specification.
## Every component belongs to lean/, packages/next and the redesigned tools.
## A has edge requires a review, not an edit, execution order or proof of completion.
## Shared consumers appear once under ReviewLanguageToolchain instead of being
## expanded after every upstream cause. This is a responsibility tree, not an import graph.
## Record implementation decisions separately from automated and human verification.
type RedesignDxnLanguage needs TreeSitterChange {
  has modify-lean-specification: ModifyLeanSpecification
}

## Begin every change by reviewing Lean definitions, proofs and concrete cases,
## together with written syntax and implementation guidance in the design notebook.
## Syntax-only or presentation-only changes may retain the semantic definitions.
## Lean proves its own definitions; TypeScript follows them through agreement tests.
type ModifyLeanSpecification needs TreeSitterChange {
  has verify-lean-specification: VerifyLeanSpecification
  has modify-syntax-contract: ModifySyntaxContract
  has modify-semantic-analyzer: ModifySemanticAnalyzer
  has modify-evaluator: ModifyEvaluator
  has modify-refactorings: ModifyRefactorings
  has stored-evidence-impact: StoredEvidenceImpact
  has modify-formatter: ModifyFormatter
  has review-language-toolchain: ReviewLanguageToolchain
}

## Run make lean for definitions, proofs and concrete examples.
## A passing proof does not establish that an executable or editor follows it.
type VerifyLeanSpecification { }

## Record grammar and valid, invalid and incomplete examples in notebook/reference.
## Review both syntax implementations and compare their acceptance and parsed names.
## TreeSitterChange describes implementation impact, not where decisions originate.
type ModifySyntaxContract needs TreeSitterChange {
  has modify-core-parser: ModifyCoreParser
  has modify-tree-sitter-package: ModifyTreeSitterPackage
  has check-parser-agreement: CheckParserAgreement
}

## Implement the core parser by hand, including parsed declarations, source spans
## and specified handling of incomplete input. It currently stops at the first error;
## recovery is a separate behavior to decide, not an existing guarantee.
type ModifyCoreParser {
  has modify-parser-diagnostics: ModifyParserDiagnostics
  has review-parser-fixes: ReviewParserFixes
  has verify-core-parser: VerifyCoreParser
}

## Review syntax-error conditions, wording and locations. Syntax errors remain
## distinct from checker rules. Both use the shared diagnostic contract below.
type ModifyParserDiagnostics { }

## Decide whether syntax corrections can be offered safely, and specify their edits.
## Parser fixes are not implemented yet. Record that outcome explicitly; this node
## does not require guessing a repair, or claim that checker naming fixes repair syntax.
type ReviewParserFixes { }

## Test valid and incomplete source, malformed tokens, exact spans and line endings.
## Verify the agreed stop or recovery behavior without silently accepting invalid syntax.
type VerifyCoreParser { }

## Review the redesigned grammar, optional external scanner, and generated artifacts.
## A grammar change requires regeneration; a scanner-only change keeps parser sources.
## The current enum/type grammar has no external scanner. A semantic-only change uses none.
type ModifyTreeSitterPackage needs TreeSitterChange {
  state tree-sitter-parser: TreeSitterParser = when TreeSitterChange {
    grammar -> regenerate
    scanner -> keep
    both -> regenerate
    none -> keep
  }
  has verify-tree-sitter-parser: VerifyTreeSitterParser
}

## Run make grammar, native parsing tests and generated-source consistency checks.
## Direct editor queries are verified under the extension responsibilities.
type VerifyTreeSitterParser { }

## Compare core and Tree-sitter syntax acceptance, parsed names and source spans.
## Expected recovery differences must be explicit. This is separate from Lean agreement.
type CheckParserAgreement { }

## Implement acceptance, identity, scope and semantic rules as they are specified.
## Review checker errors and corrections, then compare behavior with executable Lean.
type ModifySemanticAnalyzer {
  has modify-semantic-diagnostics: ModifySemanticDiagnostics
  has modify-checker-fixes: ModifyCheckerFixes
  has check-specification-agreement: CheckSpecificationAgreement
}

## Review semantic errors, severity, codes, notebook rule IDs, messages and spans.
## Keep these consistent with CLI and LSP presentations through the shared contract.
type ModifySemanticDiagnostics { }

## Review checker suggestions and precise corrections in shared language code.
## Currently these are naming fixes. Candidates must be valid and avoid collisions;
## corrections use current text and preserve unrelated text. They are not semantic rename.
type ModifyCheckerFixes { }

## Extend dxn-spec and shared/generated cases, then run make agreement.
## Compare acceptance, problems and values directly and through the core parser.
## Diagnostic wording, suggestions and positions require implementation tests too.
type CheckSpecificationAgreement { }

## Review evaluation when a specified construct introduces combinations or executable
## behavior. Types now introduce Cartesian products and counts; review the shared
## listing, CLI tables and editor counts against Lean. Executable behavior beyond
## these combinations remains unspecified; checker acceptance alone is not evaluation.
type ModifyEvaluator {
  has check-evaluation-agreement: CheckEvaluationAgreement
}

## Compare type combinations and counts with dxn-spec, including order and empty products.
## Compare CLI/editor tables separately. Future executable behavior needs its own
## specification and agreement cases; existing checker tests do not establish it.
type CheckEvaluationAgreement { }

## Refactoring is shared language behavior with explicit preconditions and results.
## Review Lean transformation laws and precise source edits. Rename currently preserves
## validity and maps values bijectively; inverse and composition laws are rename-specific.
## Parser and semantic changes can affect this responsibility even without a new operation.
type ModifyRefactorings {
  has check-refactoring-agreement: CheckRefactoringAgreement
}

## Compare transformation results and refusals with Lean. Separately verify exact edits,
## unchanged surrounding text, and re-parsing/re-checking of transformed source.
type CheckRefactoringAgreement { }

## Review records and evidence belonging to the redesigned language, including identity,
## validation and transformations needed by refactoring. This runtime is not implemented
## yet. Verification records for this workflow are separate from this language feature.
## Importing prototype records is outside this model.
type StoredEvidenceImpact {
  has verify-stored-evidence: VerifyStoredEvidence
}

## When implemented, test stored-record validation, compatibility and transformations.
## A source-rename proof does not establish that stored evidence was transformed correctly.
type VerifyStoredEvidence { }

## Review the notebook's formatting policy independently of semantic acceptance.
## Preserve names, meaning and written member order; do not format malformed syntax.
type ModifyFormatter {
  has verify-formatter: VerifyFormatter
}

## Test canonical output, idempotence, preservation of parsed declarations and line endings.
## CLI and editor formatting must exercise this same shared implementation.
type VerifyFormatter { }

## Review consumers once for all changed upstream responsibilities: syntax, checker,
## corrections, evaluation, records, formatting and refactoring. Each consumer must
## exercise the redesigned runtime. These children are not isolated from one another;
## their agreement and actual builds are checked explicitly.
type ReviewLanguageToolchain needs TreeSitterChange {
  has review-diagnostic-contract: ReviewDiagnosticContract
  has modify-editor-features: ModifyEditorFeatures
  has cli-impact: CliImpact
  has language-server-impact: LanguageServerImpact
  has vscode-extension-impact: VSCodeExtensionImpact
  has modify-zed-extension: ModifyZedExtension
  has modify-build-and-distribution: ModifyBuildAndDistribution
}

## Reconcile parser and checker diagnostics and suggestions into one shared contract:
## severity, machine code, optional rule ID, message, spans and safe correction metadata.
## Only applicable checker diagnostics carry checker-rule IDs. CLI and LSP adapt this data.
type ReviewDiagnosticContract { }

## Review hover, completion, navigation, symbols, semantic tokens, combination-count
## lenses and table display, and quick-fix actions
## for the specified constructs. Rename delegates to shared refactoring; corrections
## delegate to shared fix logic. Advertise only features actually implemented.
type ModifyEditorFeatures {
  has verify-editor-features: VerifyEditorFeatures
}

## Test current source and source ranges, incomplete input, selected corrections and
## collision checks. LSP additionally tests unsaved versions and rejection of stale edits.
type VerifyEditorFeatures { }

## Review supported executable commands, text/JSON reporting, exit codes and file writes.
## CLI language decisions, formatting, corrections and refactoring come from packages/next.
type CliImpact {
  has verify-cli: VerifyCli
}

## Run the actual executable, including invalid input, dry runs and write behavior.
## Test CLI/LSP parity for mirrored behavior. Retain command output as evidence.
type VerifyCli { }

## Review the LSP adapter and advertised capabilities for diagnostics, formatting,
## shared editor features and refactoring. Use current unsaved buffers and versioned edits.
type LanguageServerImpact {
  has verify-language-server: VerifyLanguageServer
}

## Test protocol requests, diagnostic ranges, unsaved edits, capability filtering and
## CLI parity against the redesigned runtime. Protocol tests do not verify actual editors.
type VerifyLanguageServer { }

## Review redesigned VS Code TextMate syntax, language configuration, client startup,
## bundled commands and LSP behavior. The required-change state describes the work
## decision, not implementation completion or verification success.
type VSCodeExtensionImpact {
  state required-change: RequiredChange
  has verify-vscode-extension: VerifyVSCodeExtension
  has verify-vscode-client: VerifyVSCodeClient
}

## Review redesigned Zed grammar integration, queries, language configuration, tasks
## and LSP startup. Development staging pins a real local grammar snapshot; changed
## grammar or scanner requires a new snapshot. LSP-only changes keep the grammar pin.
type ModifyZedExtension needs TreeSitterChange {
  state zed-extension-pin: ZedExtensionPin = when TreeSitterChange {
    grammar -> update
    scanner -> update
    both -> update
    none -> keep
  }
  has verify-zed-extension: VerifyZedExtension
  has verify-zed-client: VerifyZedClient
}

## Run syntax/configuration and bundle tests. A human must also load the redesigned
## development extension and inspect highlighting, indentation and bracket behavior.
## A keep decision still requires verification of affected behavior.
type VerifyVSCodeExtension { }

## Protocol and bundle tests support this responsibility. A human must exercise affected
## diagnostics, formatting, navigation, fixes and refactoring in VS Code, including unsaved
## and incomplete source. Skipped checks remain unverified; record human evidence separately.
type VerifyVSCodeClient { }

## Run grammar/query and extension checks with make zed. A human must also load the
## redesigned development extension and inspect syntax, outline, indentation and tasks.
## Automated success does not establish human editor verification.
type VerifyZedExtension { }

## A human must confirm redesigned server startup and affected LSP behavior in Zed,
## including unsaved and incomplete source. Protocol tests are supporting evidence;
## skipped human checks remain unverified and never become a pass automatically.
type VerifyZedClient { }

## Review package boundaries, dependencies, native grammar bindings, generated artifacts,
## executable entry points, alias rewriting, VS Code bundles and Zed development staging.
## This concerns distribution of the redesigned language, not a prototype cutover.
type ModifyBuildAndDistribution {
  has verify-build-and-distribution: VerifyBuildAndDistribution
}

## Run make build, make smoke and applicable grammar/extension build checks.
## Test the actual bundled server and CLI. Do not replace global tools or user settings
## as part of a build; loading an editor remains a separate human verification step.
type VerifyBuildAndDistribution { }

# Evidence recorded by the coding agent for an automated verification command.
# The implicit context identifies the verification responsibility and combination.
# Unverified means no decisive result has been established; the presence of a
# record alone does not establish success. No evidence also leaves work unverified.
# Revision identifies the source tested, output names the saved command log,
# and at records when the verification ran. Human editor checks remain separate.
record AutomatedVerification {
  command: NonEmptyString
  result: VerificationResult
  revision: NonEmptyString
  output: RelativePath
  at: Timestamp
}

# The coding agent records automated checks, not human editor sign-off.
actor CodingAgent records AutomatedVerification
