dimension TreeSitterChange = grammar | scanner | both
enum TreeSitterParser = regenerate | keep
enum ZedExtensionPin = update | keep

## Modifying the syntax of the DXN language.
##
## The change begins in Tree-sitter and requires reviewing
## the core parser, followed by checking agreement between them.
##
## This structure describes the propagation path.
type ModifyDxnGrammar needs TreeSitterChange {
  has modify-tree-sitter-package: ModifyTreeSitterPackage
}

## Modifying the Tree-sitter package. Its parser is regenerated when the grammar
## changes, and kept when only the scanner does.
type ModifyTreeSitterPackage needs TreeSitterChange {
  state tree-sitter-parser: TreeSitterParser = when TreeSitterChange {
    grammar -> regenerate
    scanner -> keep
    both -> regenerate
  }

  has modify-core-parser: ModifyCoreParser
  has modify-zed-extension: ModifyZedExtension
}

## Modifying the core parser so that it reads the changed syntax.
## Its syntax tree reaches checking and formatting through separate paths.
## Its diagnostics also reach the CLI and language server.
type ModifyCoreParser {
  has check-parser-agreement: CheckParserAgreement
  has modify-checker: ModifyChecker
  has modify-formatter: ModifyFormatter
  has modify-parser-diagnostics: ModifyParserDiagnostics
}

## Adapting checking to the changed parser output. The shared analysis entry
## point supplies checked results and diagnostics to the CLI and language server.
type ModifyChecker {
  has modify-cli: ModifyCli
  has modify-language-server: ModifyLanguageServer
}

## Adapting formatting to the changed syntax. The formatter reads syntax
## directly, independently of the checker, and serves both interfaces.
type ModifyFormatter {
  has modify-cli: ModifyCli
  has modify-language-server: ModifyLanguageServer
}

## Adapting parser diagnostics exposed through the CLI and language server,
## including syntax errors that prevent formatting.
type ModifyParserDiagnostics {
  has modify-cli: ModifyCli
  has modify-language-server: ModifyLanguageServer
}

## Adapting the command-line interface to changes in its shared language behavior.
## Each placement identifies the upstream responsibility causing the impact.
type ModifyCli { }

## Adapting the language-server interface to changes in shared language behavior.
## Each placement identifies the upstream responsibility causing the impact.
type ModifyLanguageServer { }

## Modifying the Zed extension. It pins a commit of the Tree-sitter package, and
## `make zed` fails when `grammar.js` or anything in `src/` differs from that
## commit. `src/scanner.c` is in `src/`, so the pin is updated for every kind of
## change, including a scanner change that does not regenerate the parser.
type ModifyZedExtension needs TreeSitterChange {
  state zed-extension-pin: ZedExtensionPin = when TreeSitterChange {
    grammar -> update
    scanner -> update
    both -> update
  }
}

## Checking that Tree-sitter and the core parser agree on the changed syntax.
## The check's result and supporting evidence are recorded separately.
type CheckParserAgreement { }
