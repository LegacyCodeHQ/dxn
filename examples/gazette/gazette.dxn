actor DesignAgent records PenEvidence

record PenEvidence {
  source: PenNode
}

enum Interaction = idle | hovered | pressed | disabled

type Button {
  enum Style = primary | secondary | tertiary

  state style: Style, interaction: Interaction
}

type Toggle {
  enum Setting = off | on

  state setting: Setting, interaction: Interaction
}

enum TabInteraction = idle | hovered | pressed

type Tab {
  enum Selection = unselected | selected

  state selection: Selection, interaction: TabInteraction
}
