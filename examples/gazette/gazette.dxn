actor DesignAgent records PenEvidence

record PenEvidence {
  source: PenNode
}

enum Interaction = idle | hovered | pressed | disabled
enum Touch = idle | hovered | pressed

type Button {
  enum Style = primary | secondary | tertiary

  state style: Style, interaction: Interaction
}

type Toggle {
  enum Setting = off | on

  state setting: Setting, interaction: Interaction
}

type Tab {
  enum Selection = unselected | selected

  state selection: Selection, interaction: Touch
}

type TabBar {
  enum Section = feed | saved | sources

  state section: Section

  has feed: Tab {
    selection = when section {
      feed -> selected
      else -> unselected
    }
  }

  has saved: Tab {
    selection = when section {
      saved -> selected
      else -> unselected
    }
  }

  has sources: Tab {
    selection = when section {
      sources -> selected
      else -> unselected
    }
  }
}

type BackButton {
  state interaction: Touch
}

type NavigationBar {
  enum Kind = root | pushed

  state kind: Kind

  has back: BackButton only when kind = pushed
}

type ArticleRow {
  enum Reading = unread | read
  enum Bookmark = unsaved | saved
  enum Thumbnail = without | with

  state reading: Reading, bookmark: Bookmark, thumbnail: Thumbnail
  state interaction: Touch
}

type SourceRow {
  enum Following = unfollowed | followed

  state following: Following

  has toggle: Toggle {
    setting = when following {
      followed -> on
      unfollowed -> off
    }
  }
}

type FeedScreen {
  enum Content = articles | empty

  state content: Content

  has navigation: NavigationBar { kind = root }
  has tabs: TabBar { section = feed }
  has article: ArticleRow only when content = articles
  has follow: Button { style = primary } only when content = empty
}
