{
  "$schema": "../../schema/tree.schema.json",
  "version": 1,
  "customAttributes": {
    "design": { "values": ["available", "missing"] }
  },
  "types": {
    "link": {
      "states": ["normal", "hovered", "selected"],
      "customAttributes": {
        "design": { "normal": "available", "hovered": "available", "selected": "missing" }
      }
    }
  },
  "tasks": [
    {
      "id": "article-page",
      "title": "Article page",
      "children": [
        {
          "id": "top-toolbar",
          "title": "Top toolbar",
          "children": [
            { "id": "logo-mark", "title": "Logo mark" },
            {
              "id": "blog-link",
              "title": "Blog link",
              "type": "link",
              "customAttributes": {
                "design": { "selected": "available" }
              }
            }
          ]
        }
      ]
    }
  ]
}
